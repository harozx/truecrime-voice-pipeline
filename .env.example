# Copy file này thành .env rồi điền giá trị của bạn.
# Đường dẫn tương đối được tính từ thư mục dự án.

# === Google Sheets (danh sách video cần làm) ===
SPREADSHEET_ID=your_spreadsheet_id
SHEET_NAME=OL1
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json

# === Gemini ===
# Nhiều key: ghi vào api_keys.txt (mỗi dòng 1 key) hoặc ngăn bằng dấu phẩy ở đây
GEMINI_API_KEY=
API_KEYS_FILE=api_keys.txt
GEMINI_MODEL=gemini-2.5-flash

# === Whisper ===
WHISPER_MODEL=base

# === Dự án bên ngoài (mặc định nằm cạnh thư mục này) ===
YT_DOWNLOADER_DIR=../yt_downloader
TRUYEN_DIR=../truyen
VIRA_TTS_DIR=../Vira-tts

# === Giọng mẫu và kết quả ===
VOICE_REF=voicegoc.MP3
OUTPUT_DIR=output_voice
LOG_FILE=auto_processor.log
